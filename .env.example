# Finnhub — https://finnhub.io/register (plan gratuit)
FINNHUB_API_KEY=remplace_moi

# Symboles à streamer (large caps très liquides, marché toujours actif en heures d'ouverture US)
STOCK_SYMBOLS=AAPL,MSFT,AMZN,TSLA,NVDA

# MinIO (data lake S3-compatible)
MINIO_ROOT_USER=marketpulse
MINIO_ROOT_PASSWORD=change_moi_stp
MINIO_ENDPOINT=http://localhost:9000

# Kafka (depuis ta machine hôte, hors conteneurs)
KAFKA_BOOTSTRAP_SERVERS=localhost:29092
KAFKA_TOPIC_TRADES=stock.trades
